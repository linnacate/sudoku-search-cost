    given-names: "Kangyu"
    orcid: "https://orcid.org/0009-0000-3125-3754"
    affiliation: "Independent Researcher, Xinxiang, Henan, China"
license: MIT
repository-code: "https://github.com/linnacate/sudoku-search-cost"
keywords:
  - constraint satisfaction
  - Sudoku
  - search heuristics
  - backdoors
  - adaptive variable ordering
  - solver-relative difficulty
