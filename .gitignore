# .gitignore —— 公开仓库里**不应该**提交的东西
#
# 设计原则：
#   * 仓库 = 可审计的**源码 + 文档 + 文档级元数据**
#   * 大体积的题库数据、编译产物、逐题结果，走 Release 附件 / Zenodo，不入 git 历史
#   * 论坛题库的许可状态不明确，尤其不要进公开仓库（见 DATA_NOTICE.md）

# ---------- 编译产物 ----------
bin/
build_win/
*.o
*.obj
*.exe
*.log

# ---------- Python ----------
__pycache__/
*.pyc

# ---------- 第三方源码 —— 本仓库不分发，使用者自行获取 ----------
third_party/

# ---------- 数据集：许可状态不明确，不入仓库 ----------
# 需要的话，按 DATA_NOTICE.md 里的来源自行获取，并用其中的 md5 校验
data/*.txt

# ---------- 逐题结果：体积大，走 Release 附件 ----------
# 保留 results/ 下的说明文件，但排除大 TSV
results/*.tsv
!results/README.md
